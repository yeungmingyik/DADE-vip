{
  "name": "sspc-vip",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-app.mjs member --dev",
    "start": "node scripts/start-app.mjs member",
    "test": "vitest run",
    "check:release": "node scripts/check-release.mjs",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start:member": "node scripts/start-app.mjs member",
    "start:staff": "node scripts/start-app.mjs staff",
    "start:admin": "node scripts/start-app.mjs admin",
    "demo": "node scripts/run-demo.mjs",
    "test:integration": "node tests/surface-integration.mjs",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/prepare-pages.mjs",
    "preview:pages": "vite preview --config vite.pages.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-intl": "4.14.6",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
